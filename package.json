{
  "name": "tetrisweb",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p worker/tsconfig.json --noEmit",
    "cf-typegen": "wrangler types",
    "deploy": "vite build && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261118.1",
    "@types/node": "^22.15.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "^4.164.0"
  }
}
