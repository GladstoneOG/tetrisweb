{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["@cloudflare/workers-types", "node"]
  },
  "include": ["./**/*.ts", "../src/shared/**/*.ts", "../tests/worker/**/*.ts"]
}
